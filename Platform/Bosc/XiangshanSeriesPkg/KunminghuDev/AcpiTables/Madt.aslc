#include <Library/AcpiLib.h>
#include <Library/PcdLib.h>
#include <IndustryStandard/Acpi.h>

#include "AcpiHeader.h"

//
// Multiple APIC Description Table
//
#pragma pack (1)

typedef struct {
  UINT8  Type;
  UINT8  Length;
  UINT8  Version;
  UINT8  Id;
  UINT8  HwId[8];
  UINT16 NumIrqs;
  UINT16 MaxPrio;
  UINT32 Flags;
  UINT32 Size;
  UINT64 Base;
  UINT32 GsiBase;
} EFI_ACPI_MADT_PLIC_STRUCTURE;

typedef struct {
  UINT8  Type;
  UINT8  Length;
  UINT8  Version;
  UINT8  Id;
  UINT32 Flags;
  UINT8  HwId[8];
  UINT16 NumIdcs;
  UINT16 NumSrcs;
  UINT32 GsiBase;
  UINT64 Base;
  UINT32 Size;
} EFI_ACPI_MADT_APLIC_STRUCTURE;

typedef struct {
  UINT8  Type;
  UINT8  Length;
  UINT8  Version;
  UINT8  AplicId;
  UINT32 Flags;
  UINT16 NumIds;
  UINT16 NumGuestIds;
  UINT8  GuestIdxBits;
  UINT8  HartIdxBits;
  UINT8  GroupIdxBits;
  UINT8  GroupIdxShift;
} EFI_ACPI_MADT_IMSIC_STRUCTURE;

typedef struct {
  UINT8  Type;
  UINT8  Length;
  UINT8  Version;
  UINT8  Reserved;
  UINT32 Flags;
  UINT64 HartId;
  UINT32 Uid;
  UINT32 ExtIntcId;
  UINT64 ImsicBase;
  UINT32 ImsicSize;
} EFI_ACPI_MADT_INTC_STRUCTURE;

typedef struct {
  EFI_ACPI_6_0_MULTIPLE_APIC_DESCRIPTION_TABLE_HEADER   Header;
  EFI_ACPI_MADT_INTC_STRUCTURE                          Intc[1];
  EFI_ACPI_MADT_IMSIC_STRUCTURE                         Imisc[1];
  EFI_ACPI_MADT_APLIC_STRUCTURE                         Aplic[1];
} EFI_ACPI_6_0_MULTIPLE_APIC_DESCRIPTION_TABLE;

#pragma pack ()

EFI_ACPI_6_0_MULTIPLE_APIC_DESCRIPTION_TABLE Madt = {
  {
    ACPI_HEADER (
      EFI_ACPI_6_0_MULTIPLE_APIC_DESCRIPTION_TABLE_SIGNATURE,
      EFI_ACPI_6_0_MULTIPLE_APIC_DESCRIPTION_TABLE,
      EFI_ACPI_6_0_MULTIPLE_APIC_DESCRIPTION_TABLE_REVISION
    ),
    //
    // MADT specific fields
    //
    0, // LocalApicAddress
    0, // Flags
  },
  {
    /* Intc[0] */
    {
      0x18,                // Type
      36,                  // Length
      1,                   // Version
      0,                   // Reserved
      1,                   // Flags
      0,                   // HartId
      0,                   // Uid
      0,                   // ExtIntcId
      0x3b000000,          // ImsicBase
      0x8000,              // ImsicSize
    },
  },
  {
    /* Imsic[0] */
    {
      0x19,               // Type
      16,                 // Length
      1,                  // Version
      0,                  // Reserved
      0,                  // Flags
      255,                // NumIds
      255,                // NumGuestIds
      3,                  // GuestIdxBits
      4,                  // HartIdxBits
      0,                  // GroupIdxBits
      24,                 // GroupIdxShift
    },
  },
  {
    /* Aplic[0] */
    {
      0x1A,               // Type
      36,                 // Length
      1,                  // Version
      0,                  // AplicId
      0,                  // Flags
      /* HwId[8] */
      {
        0, 0, 0, 0, 0, 0, 0, 0
      },
      0,                  // NumIdcs
      32,                 // NumSrcs
      0,                  // GsiBase
      0x31120000,         // BaseAddr
      0x8000,             // Size
    },
  },
};

//
// Reference the table being generated to prevent the optimizer
// from removing the data structure from the executable
//
VOID* CONST ReferenceAcpiTable = &Madt;
