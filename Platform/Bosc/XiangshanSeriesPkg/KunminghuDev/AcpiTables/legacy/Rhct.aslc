#include <Library/AcpiLib.h>
#include <Library/PcdLib.h>
#include <IndustryStandard/Acpi.h>

#include "AcpiHeader.h"

#define N_NODE 4  // changed to 4 cores.
#define N_HART_INFO_OFFSET 3
#define RHCT_ISA_STRING_LENGTH 1024

#pragma pack (1)

typedef struct {
  UINT16 Type;
  UINT16 Length;
  UINT16 Revision;
} EFI_RHCT_NODE_HEADER;

typedef struct {
  UINT16 NumOffsets;
  UINT32 Uid;
} EFI_RHCT_HART_INFO;

typedef struct {
  EFI_RHCT_NODE_HEADER Header;
  EFI_RHCT_HART_INFO   HartInfo;
} EFI_RHCT_HART_INFO_STRUCT;

typedef struct {
  UINT32 Offset[N_HART_INFO_OFFSET];
} EFI_RHCT_HART_NODE_INFO_OFFSET;

typedef struct {
  UINT16 IsaLength;
  UINT8  IsaString[RHCT_ISA_STRING_LENGTH];
} EFI_RHCT_ISA_STRING;

typedef struct {
  UINT8 Reserved;
  UINT8 CbomBlockSize;
  UINT8 CbopBlockSize;
  UINT8 CbozBlockSize;
} EFI_RHCT_CMO;

typedef struct {
  UINT8 Reserved;
  UINT8 MmuType;
} EFI_RHCT_MMU;

typedef struct {
  EFI_RHCT_NODE_HEADER Header;
  EFI_RHCT_ISA_STRING  IsaData;
} EFI_RHCT_ISA_STRING_STRUCT;

typedef struct {
  EFI_RHCT_NODE_HEADER Header;
  EFI_RHCT_CMO         CmoData;
} EFI_RHCT_CMO_STRUCT;

typedef struct {
  EFI_RHCT_NODE_HEADER Header;
  EFI_RHCT_MMU         MmuData;
} EFI_RHCT_MMU_STRUCT;

typedef struct {
  EFI_RHCT_HART_INFO_STRUCT      HartInfo;
  EFI_RHCT_HART_NODE_INFO_OFFSET Offset;
  EFI_RHCT_ISA_STRING_STRUCT     IsaNode;
  EFI_RHCT_CMO_STRUCT            CmoNode;
  EFI_RHCT_MMU_STRUCT            MmuNode;
} EFI_RHCT_NODE_DATA;

typedef struct {
  UINT32 Reserved;
  UINT64 BaseFrequency;
  UINT32 NodeNumber;
  UINT32 OffsetToNodeArray;
} EFI_RHCT_HEADER_STRUCTURE;

typedef struct {
  EFI_ACPI_DESCRIPTION_HEADER Header;
  EFI_RHCT_HEADER_STRUCTURE   RhctHeader;
  EFI_RHCT_NODE_DATA          Node[N_NODE];
} EFI_ACPI_6_0_RHCT_DESCRIPTION_TABLE;

#pragma pack ()

#define RHCT_NODE_BASE(_uid)  (sizeof (EFI_ACPI_DESCRIPTION_HEADER) +                                sizeof (EFI_RHCT_HEADER_STRUCTURE) +                                (sizeof (EFI_RHCT_NODE_DATA) * (_uid)))

#define RHCT_NODE_INIT(_uid)  {   {     {       0xFFFF,       sizeof (EFI_RHCT_HART_INFO_STRUCT) +       sizeof (EFI_RHCT_HART_NODE_INFO_OFFSET) +       sizeof (EFI_RHCT_ISA_STRING_STRUCT),       1,     },     {       3,       (_uid),     },   },   {     {       RHCT_NODE_BASE (_uid) + sizeof (EFI_RHCT_HART_INFO_STRUCT) + sizeof (EFI_RHCT_HART_NODE_INFO_OFFSET),       RHCT_NODE_BASE (_uid) + sizeof (EFI_RHCT_HART_INFO_STRUCT) + sizeof (EFI_RHCT_HART_NODE_INFO_OFFSET) + sizeof (EFI_RHCT_ISA_STRING_STRUCT),       RHCT_NODE_BASE (_uid) + sizeof (EFI_RHCT_HART_INFO_STRUCT) + sizeof (EFI_RHCT_HART_NODE_INFO_OFFSET) + sizeof (EFI_RHCT_ISA_STRING_STRUCT) + sizeof (EFI_RHCT_CMO_STRUCT),     },   },   {     {       0,       sizeof (EFI_RHCT_NODE_HEADER) + sizeof (EFI_RHCT_ISA_STRING),       1     },     {       RHCT_ISA_STRING_LENGTH,       "rv64imafdcvh_sdring_sha_shcounternw_shgatpa_shlcofideleg_shtvala_shvsatpa_shvstvala_shvstvecd_smaia_smcsrind_smdbltrp_smmpm_smnpm_smrnmi_smstateen_sspl13_ssaia_ssccptr_ssconfpmf_sscounterenw_sscsrind_ssdbltrp_ssnpm_sspm_ssstateen_ssstrict_sstc_sstvala_sstvecd_ssu64xl_supm_svade_svbare_svinval_svnapot_za64rs_zacas_zawrs_zba_zbb_zbc_zbkb_zbkc_zbkx_zbs_zcb_zcmop_zfa_zfh_zfhmin_zic64b_zicbom_zicbop_zicboz_ziccamoa_ziccif_zicclsm_ziccrse_zicntr_zicond_zicsr_zifencei_zihintntl_zihintpause_zihpm_zimop_zkn_zknd_zkne_zknh_zksed_zksh_zkt_zvbb_zvfn_zvfhmin_zvkt_zv1128b_zv132b_zv164b",     },   },   {     {       1,       sizeof (EFI_RHCT_CMO_STRUCT),       1     },     {       0,       64,       64,       64     },   },   {     {       2,       sizeof (EFI_RHCT_MMU_STRUCT),       1     },     {       0,       1     },   } }

EFI_ACPI_6_0_RHCT_DESCRIPTION_TABLE Rhct = {
  ACPI_HEADER (
    EFI_ACPI_6_0_MULTIPLE_RHCT_DESCRIPTION_TABLE_SIGNATURE,
    EFI_ACPI_6_0_RHCT_DESCRIPTION_TABLE,
    EFI_ACPI_6_0_MULTIPLE_RHCT_DESCRIPTION_TABLE_REVISION
  ),
  {
    0,
    1000000,
    N_NODE,
    sizeof (EFI_ACPI_DESCRIPTION_HEADER) + sizeof (EFI_RHCT_HEADER_STRUCTURE)
  },
  {
    RHCT_NODE_INIT (0),
    RHCT_NODE_INIT (1),
    RHCT_NODE_INIT (2),
    RHCT_NODE_INIT (3),
  },
};

VOID* CONST ReferenceAcpiTable = &Rhct;
