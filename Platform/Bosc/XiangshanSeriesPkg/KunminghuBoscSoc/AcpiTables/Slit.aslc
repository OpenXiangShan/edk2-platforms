/** @file
*  System Locality Distance Information Table (SLIT) for QEMU kmh-bosc-soc.
*
*  SPDX-License-Identifier: BSD-2-Clause-Patent
*
**/

#include <Library/AcpiLib.h>
#include <IndustryStandard/Acpi.h>

#include "AcpiHeader.h"

#define KMH_BOSC_NUMA_NODES        4
#define KMH_BOSC_LOCAL_DISTANCE    10
#define KMH_BOSC_REMOTE_DISTANCE   20

typedef struct {
  EFI_ACPI_6_0_SYSTEM_LOCALITY_DISTANCE_INFORMATION_TABLE_HEADER Header;
  UINT8 Distance[KMH_BOSC_NUMA_NODES][KMH_BOSC_NUMA_NODES];
} EFI_ACPI_STATIC_LOCALITY_DISTANCE_TABLE;

EFI_ACPI_STATIC_LOCALITY_DISTANCE_TABLE Slit = {
  {
    ACPI_HEADER (
      EFI_ACPI_6_0_SYSTEM_LOCALITY_INFORMATION_TABLE_SIGNATURE,
      EFI_ACPI_STATIC_LOCALITY_DISTANCE_TABLE,
      EFI_ACPI_6_0_SYSTEM_LOCALITY_DISTANCE_INFORMATION_TABLE_REVISION
    ),
    KMH_BOSC_NUMA_NODES,
  },
  {
    { KMH_BOSC_LOCAL_DISTANCE,  KMH_BOSC_REMOTE_DISTANCE, KMH_BOSC_REMOTE_DISTANCE, KMH_BOSC_REMOTE_DISTANCE },
    { KMH_BOSC_REMOTE_DISTANCE, KMH_BOSC_LOCAL_DISTANCE,  KMH_BOSC_REMOTE_DISTANCE, KMH_BOSC_REMOTE_DISTANCE },
    { KMH_BOSC_REMOTE_DISTANCE, KMH_BOSC_REMOTE_DISTANCE, KMH_BOSC_LOCAL_DISTANCE,  KMH_BOSC_REMOTE_DISTANCE },
    { KMH_BOSC_REMOTE_DISTANCE, KMH_BOSC_REMOTE_DISTANCE, KMH_BOSC_REMOTE_DISTANCE, KMH_BOSC_LOCAL_DISTANCE  },
  },
};

VOID* CONST ReferenceAcpiTable = &Slit;
