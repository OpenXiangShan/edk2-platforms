#include <Library/AcpiLib.h>
#include <Library/PcdLib.h>
#include <IndustryStandard/Acpi.h>

#include "AcpiHeader.h"

#define KMH_BOSC_CPU_NUM                  64
#define KMH_BOSC_RHCT_NODE_COUNT          (3 + KMH_BOSC_CPU_NUM)
#define KMH_BOSC_RHCT_ISA_STRING          "rv64imafdcvh_sdring_sha_shcounternw_shgatpa_shlcofideleg_shtvala_shvsatpa_shvstvala_shvstvecd_smaia_smcsrind_smdbltrp_smmpm_smnpm_smrnmi_smstateen_sspl13_ssaia_ssccptr_ssconfpmf_sscounterenw_sscsrind_ssdbltrp_ssnpm_sspm_ssstateen_ssstrict_sstc_sstvala_sstvecd_ssu64xl_supm_svade_svbare_svinval_svnapot_za64rs_zacas_zawrs_zba_zbb_zbc_zbkb_zbkc_zbkx_zbs_zcb_zcmop_zfa_zfh_zfhmin_zic64b_zicbom_zicbop_zicboz_ziccamoa_ziccif_zicclsm_ziccrse_zicntr_zicond_zicsr_zifencei_zihintntl_zihintpause_zihpm_zimop_zkn_zknd_zkne_zknh_zksed_zksh_zkt_zvbb_zvfn_zvfhmin_zvkt_zv1128b_zv132b_zv164b"

#define KMH_BOSC_FOR_EACH_HART(M) \
  M (0)  M (1)  M (2)  M (3)  M (4)  M (5)  M (6)  M (7)  \
  M (8)  M (9)  M (10) M (11) M (12) M (13) M (14) M (15) \
  M (16) M (17) M (18) M (19) M (20) M (21) M (22) M (23) \
  M (24) M (25) M (26) M (27) M (28) M (29) M (30) M (31) \
  M (32) M (33) M (34) M (35) M (36) M (37) M (38) M (39) \
  M (40) M (41) M (42) M (43) M (44) M (45) M (46) M (47) \
  M (48) M (49) M (50) M (51) M (52) M (53) M (54) M (55) \
  M (56) M (57) M (58) M (59) M (60) M (61) M (62) M (63)

#pragma pack (1)

typedef struct {
  UINT16 Type;
  UINT16 Length;
  UINT16 Revision;
} EFI_RHCT_NODE_HEADER;

typedef struct {
  UINT16 NumOffsets;
  UINT32 Uid;
} EFI_RHCT_HART_INFO;

typedef struct {
  EFI_RHCT_NODE_HEADER Header;
  EFI_RHCT_HART_INFO   HartInfo;
  UINT32               Offset[3];
} EFI_RHCT_HART_NODE;

typedef struct {
  EFI_RHCT_NODE_HEADER Header;
  UINT16               IsaLength;
  CHAR8                IsaString[sizeof (KMH_BOSC_RHCT_ISA_STRING)];
  UINT8                Padding;
} EFI_RHCT_ISA_NODE;

typedef struct {
  EFI_RHCT_NODE_HEADER Header;
  UINT8                Reserved;
  UINT8                CbomBlockSize;
  UINT8                CbopBlockSize;
  UINT8                CbozBlockSize;
} EFI_RHCT_CMO_NODE;

typedef struct {
  EFI_RHCT_NODE_HEADER Header;
  UINT8                Reserved;
  UINT8                MmuType;
} EFI_RHCT_MMU_NODE;

typedef struct {
  UINT32 Reserved;
  UINT64 BaseFrequency;
  UINT32 NodeNumber;
  UINT32 OffsetToNodeArray;
} EFI_RHCT_HEADER_STRUCTURE;

typedef struct {
  EFI_ACPI_DESCRIPTION_HEADER Header;
  EFI_RHCT_HEADER_STRUCTURE   RhctHeader;
  EFI_RHCT_ISA_NODE           IsaNode;
  EFI_RHCT_CMO_NODE           CmoNode;
  EFI_RHCT_MMU_NODE           MmuNode;
  EFI_RHCT_HART_NODE          HartNode[KMH_BOSC_CPU_NUM];
} EFI_ACPI_6_0_RHCT_DESCRIPTION_TABLE;

#pragma pack ()

#define KMH_RHCT_HART_NODE_INIT(Uid) { \
  { \
    0xFFFF, \
    sizeof (EFI_RHCT_HART_NODE), \
    1, \
  }, \
  { \
    3, \
    (Uid), \
  }, \
  { \
    OFFSET_OF (EFI_ACPI_6_0_RHCT_DESCRIPTION_TABLE, IsaNode), \
    OFFSET_OF (EFI_ACPI_6_0_RHCT_DESCRIPTION_TABLE, CmoNode), \
    OFFSET_OF (EFI_ACPI_6_0_RHCT_DESCRIPTION_TABLE, MmuNode), \
  }, \
},

EFI_ACPI_6_0_RHCT_DESCRIPTION_TABLE Rhct = {
  ACPI_HEADER (
    EFI_ACPI_6_0_MULTIPLE_RHCT_DESCRIPTION_TABLE_SIGNATURE,
    EFI_ACPI_6_0_RHCT_DESCRIPTION_TABLE,
    EFI_ACPI_6_0_MULTIPLE_RHCT_DESCRIPTION_TABLE_REVISION
  ),
  {
    0,
    1000000,
    KMH_BOSC_RHCT_NODE_COUNT,
    sizeof (EFI_ACPI_DESCRIPTION_HEADER) + sizeof (EFI_RHCT_HEADER_STRUCTURE)
  },
  {
    {
      0,
      sizeof (EFI_RHCT_ISA_NODE),
      1
    },
    sizeof (KMH_BOSC_RHCT_ISA_STRING),
    KMH_BOSC_RHCT_ISA_STRING,
    0
  },
  {
    {
      1,
      sizeof (EFI_RHCT_CMO_NODE),
      1
    },
    0,
    64,
    64,
    64
  },
  {
    {
      2,
      sizeof (EFI_RHCT_MMU_NODE),
      1
    },
    0,
    1
  },
  {
    KMH_BOSC_FOR_EACH_HART (KMH_RHCT_HART_NODE_INIT)
  },
};

VOID* CONST ReferenceAcpiTable = &Rhct;
